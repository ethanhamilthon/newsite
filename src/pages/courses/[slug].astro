---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.jpg';
import Icon from '../../components/Icon.astro';
import { LINKS, SOCIAL, waLink } from '../../config';
import CourseLayout from '../../layouts/CourseLayout.astro';
import { formatPrice, getCourses, type Course } from '../../lib/content';

export async function getStaticPaths() {
  const courses = await getCourses();
  return courses.map((course) => ({ params: { slug: course.id }, props: { course } }));
}

const { course } = Astro.props as { course: Course };
const d = course.data;
const { Content } = await render(course);
const signup = waLink(d.waText);
const price = `${formatPrice(d.price)} ${d.currency}`;

// Split the title at ':' so the second part can sit on its own line.
const [titleTop, titleBottom] = d.title.includes(':') ? d.title.split(/:\s*/, 2) : [d.title, ''];
---

<CourseLayout title={`${d.title} — Yerdana`} description={d.subtitle}>
  <div class="page">
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="bg-glow" aria-hidden="true"></div>

    <header class="nav">
      <a href="/" class="brand">
        <Image src={avatar} alt="" width={48} height={48} />
        <span>Yerdana</span>
      </a>
      <span class="bar" aria-hidden="true"></span>
    </header>

    <section class="hero">
      <p class="pill"><span>!</span> Мини-курс · {price}</p>
      <h1>
        {titleTop}
        {titleBottom && <br />}
        {titleBottom && <span class="h-2">{titleBottom}</span>}
      </h1>
      <p class="lead">{d.subtitle}</p>

      <div class="video-wrap">
        {d.badges[0] && <span class="float f1"><i>◌</i>{d.badges[0]}</span>}
        {d.badges[1] && <span class="float f2"><i>✦</i>{d.badges[1]}</span>}
        {d.badges[2] && <span class="float f3"><i>✺</i>{d.badges[2]}</span>}
        {d.badges[3] && <span class="float f4"><i>▶</i>{d.badges[3]}</span>}

        <div class="video">
          {
            d.videoId ? (
              <button class="yt" type="button" data-id={d.videoId} aria-label="Видеоны қосу">
                <img src={`https://i.ytimg.com/vi/${d.videoId}/maxresdefault.jpg`} alt="" loading="eager" />
                <span class="play" aria-hidden="true" />
              </button>
            ) : (
              <div class="placeholder">
                <Image src={avatar} alt="" width={720} height={720} class="ph-img" />
                <span class="play" aria-hidden="true" />
                <span class="ph-text">Видео жақында шығады</span>
              </div>
            )
          }
        </div>
      </div>

      <a href={signup} target="_blank" rel="noopener" class="cta big">
        <Icon name="whatsapp" size={20} />
        Жазылу · {price}
      </a>
    </section>

    <section class="block intro">
      <div class="prose"><Content /></div>
    </section>

    <section class="block">
      <p class="eyebrow">🎯 Кімге арналған</p>
      <h2>Бұл курс саған, егер…</h2>
      <ul class="cards">
        {
          d.audience.map((a, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span>{a}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <p class="eyebrow">📚 Программа</p>
      <h2>{d.program.length} сабақ: нөлден фильмге дейін</h2>
      <ol class="program">
        {
          d.program.map((p, i) => (
            <li>
              <span class="step">{i + 1}</span>
              <span class="pt">{p}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="block">
      <div class="price-card">
        <p class="eyebrow">💵 Бағасы</p>
        <div class="price">{price}</div>
        <p class="muted">Бір рет төлейсің. Толық ақпаратты жоғарыдағы видеодан көр 👆🏻</p>
        <a href={signup} target="_blank" rel="noopener" class="cta big">
          <Icon name="whatsapp" size={20} />
          WhatsApp арқылы жазылу
        </a>
        <p class="small muted">Сұрағың болса: <a href={LINKS.telegram} target="_blank" rel="noopener">Telegram @{SOCIAL.telegram}</a></p>
      </div>
    </section>

    <footer class="foot">
      <div class="socials">
        <a href={LINKS.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" /></a>
        <a href={LINKS.telegram} target="_blank" rel="noopener" aria-label="Telegram"><Icon name="telegram" /></a>
        <a href={LINKS.youtube} target="_blank" rel="noopener" aria-label="YouTube"><Icon name="youtube" /></a>
        <a href={LINKS.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>
        <a href={LINKS.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><Icon name="tiktok" /></a>
      </div>
      <a href="/" class="muted">← yerdana.com</a>
    </footer>

    <a href={signup} target="_blank" rel="noopener" class="sticky-cta">
      <Icon name="whatsapp" size={18} /> Жазылу · {price}
    </a>
  </div>
</CourseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('button.yt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.id}?autoplay=1&rel=0&playsinline=1`;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.title = 'Курс туралы видео';
      btn.replaceWith(iframe);
    });
  });

  // Hide the sticky button while the hero button is on screen.
  const sticky = document.querySelector('.sticky-cta');
  const heroCta = document.querySelector('.hero .cta');
  if (sticky && heroCta && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => sticky.classList.toggle('show', !e.isIntersecting)).observe(heroCta);
  }
</script>

<style>
  .page {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 20px 120px;
    isolation: isolate;
  }

  .bg-grid {
    position: absolute;
    inset: 0 -20px auto;
    height: 900px;
    z-index: -1;
    background-image:
      linear-gradient(var(--c-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-line) 1px, transparent 1px);
    background-size: 120px 120px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 20%, #000 30%, transparent 75%);
  }

  .bg-glow {
    position: absolute;
    left: 50%;
    top: 30px;
    width: 640px;
    max-width: 100vw;
    height: 420px;
    transform: translateX(-50%);
    z-index: -1;
    background: radial-gradient(ellipse 50% 60% at 50% 0%, rgba(var(--c-glow), 0.28), transparent 70%);
    pointer-events: none;
  }

  /* nav */
  .nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding-top: 22px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    font-size: 17px;
  }

  .brand img {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
  }

  .bar {
    width: 150px;
    height: 4px;
    border-radius: 4px;
    background: var(--c-lime);
    box-shadow: 0 6px 40px 6px rgba(var(--c-glow), 0.45);
  }

  /* hero */
  .hero {
    text-align: center;
    padding-top: 56px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 18px;
    font-size: 13px;
    color: var(--c-muted);
  }

  .pill span {
    color: var(--c-peach-1);
    font-weight: 800;
  }

  h1 {
    margin: 0 auto;
    max-width: 880px;
    font-size: clamp(34px, 7vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 700;
    background: linear-gradient(180deg, var(--c-peach-1) 10%, var(--c-peach-2) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-wrap: balance;
  }

  .h-2 {
    font-size: 0.72em;
  }

  .lead {
    max-width: 560px;
    margin: 22px auto 0;
    color: var(--c-muted);
    font-size: 16px;
    text-wrap: balance;
  }

  /* video */
  .video-wrap {
    position: relative;
    max-width: 760px;
    margin: 56px auto 0;
  }

  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    background: var(--c-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 0 0 6px rgba(255, 255, 255, 0.03),
      0 30px 80px -10px rgba(var(--c-glow), 0.18),
      0 20px 60px rgba(0, 0, 0, 0.6);
  }

  .video :global(iframe),
  .yt {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt {
    padding: 0;
    cursor: pointer;
    background: #000;
  }

  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 40%, #1d1d1d, #0b0b0b);
  }

  .placeholder :global(.ph-img) {
    position: absolute;
    left: 6%;
    bottom: 0;
    height: 92%;
    width: auto;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1) brightness(0.8);
    mask-image: linear-gradient(90deg, transparent, #000 25%, #000 75%, transparent), linear-gradient(0deg, transparent, #000 30%);
    mask-composite: intersect;
    opacity: 0.7;
  }

  .ph-text {
    position: absolute;
    right: 6%;
    bottom: 10%;
    font-size: clamp(18px, 4vw, 34px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.85);
    text-align: right;
    max-width: 50%;
    line-height: 1.1;
  }

  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 64px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: transform 0.2s, background 0.2s;
  }

  .play::after {
    content: '';
    position: absolute;
    left: 26px;
    top: 21px;
    border-left: 16px solid #fff;
    border-top: 11px solid transparent;
    border-bottom: 11px solid transparent;
  }

  .yt:hover .play {
    transform: translate(-50%, -50%) scale(1.08);
    background: rgba(255, 255, 255, 0.22);
  }

  .float {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 11px;
    border-radius: 8px;
    background: rgba(28, 28, 28, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(6px);
    font-size: 12.5px;
    font-style: italic;
    color: #e6e2da;
    white-space: nowrap;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }

  .float i {
    font-style: normal;
    color: var(--c-peach-2);
  }

  .f1 {
    left: -56px;
    top: -14px;
  }
  .f2 {
    right: -72px;
    top: 44%;
  }
  .f3 {
    left: -88px;
    bottom: 12%;
  }
  .f4 {
    right: -30px;
    bottom: -14px;
  }

  @media (max-width: 900px) {
    .f1 {
      left: 8px;
    }
    .f2 {
      right: 8px;
      top: -14px;
    }
    .f3 {
      left: 8px;
      bottom: -14px;
    }
    .f4 {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .float {
      font-size: 11px;
      padding: 4px 8px;
    }
    .f2 {
      display: none;
    }
  }

  /* cta */
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 28px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 16px;
    color: #1a1208 !important;
    background: linear-gradient(180deg, var(--c-peach-1), var(--c-peach-2));
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.25) inset,
      0 10px 40px -6px rgba(var(--c-glow), 0.55);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .cta:hover {
    transform: translateY(-1px);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.35) inset,
      0 14px 50px -6px rgba(var(--c-glow), 0.7);
  }

  .hero .cta {
    margin-top: 48px;
  }

  /* blocks */
  .block {
    max-width: 760px;
    margin: 96px auto 0;
  }

  .intro .prose {
    font-size: clamp(18px, 2.4vw, 22px);
    line-height: 1.55;
    color: #d9d5cc;
    text-align: center;
  }

  .intro .prose :global(p) {
    margin: 0 0 1em;
  }

  .intro .prose :global(strong) {
    color: var(--c-peach-1);
  }

  .eyebrow {
    margin: 0 0 8px;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-muted);
  }

  h2 {
    margin: 0 0 28px;
    font-size: clamp(26px, 4vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 700;
  }

  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  @media (min-width: 700px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
    .cards li:last-child:nth-child(odd) {
      grid-column: span 2;
    }
  }

  .cards li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 18px;
    border-radius: 14px;
    background: var(--c-card);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .num {
    font-size: 12px;
    font-weight: 700;
    color: var(--c-peach-2);
    padding-top: 3px;
  }

  .program {
    list-style: none;
    margin: 0;
    padding: 0;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.07);
  }

  .program li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: var(--c-card);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .program li:last-child {
    border-bottom: 0;
  }

  .program li:nth-child(even) {
    background: #0e0e0e;
  }

  .step {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 700;
    color: #1a1208;
    background: linear-gradient(180deg, var(--c-peach-1), var(--c-peach-2));
  }

  .pt {
    font-weight: 500;
  }

  .price-card {
    text-align: center;
    padding: 44px 24px;
    border-radius: 22px;
    background:
      radial-gradient(ellipse 60% 80% at 50% 0%, rgba(var(--c-glow), 0.14), transparent 70%),
      var(--c-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .price {
    font-size: clamp(48px, 9vw, 76px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    background: linear-gradient(180deg, var(--c-peach-1), var(--c-peach-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .price-card .muted {
    margin: 14px auto 28px;
    max-width: 420px;
  }

  .price-card .small {
    margin: 22px 0 0;
    font-size: 14px;
  }

  .price-card .small a {
    text-decoration: underline;
  }

  .muted {
    color: var(--c-muted);
  }

  .foot {
    margin-top: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    font-size: 14px;
  }

  .socials {
    display: flex;
    gap: 22px;
    color: var(--c-muted);
  }

  .socials a:hover {
    color: var(--c-text);
  }

  .sticky-cta {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px;
    border-radius: 999px;
    font-weight: 700;
    color: #1a1208 !important;
    background: linear-gradient(180deg, var(--c-peach-1), var(--c-peach-2));
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    transform: translateY(140%);
    transition: transform 0.25s;
  }

  .sticky-cta:global(.show) {
    transform: none;
  }

  @media (min-width: 900px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
